# ==============================================================================
# AI-Driven Digital Twin for Smart Factory Operations 
# Configuration Environment Variables
# Copy this file to .env and adjust variables as required for local setup
# ==============================================================================

# Application Security
FLASK_ENV=development
SECRET_KEY=dev_secret_key_change_in_production_12345!
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600

# SQLite Database
DATABASE_PATH=factory_twin.db

# Machine Simulation Configuration
SIMULATION_ENABLED=True
SIMULATION_INTERVAL_SECONDS=3.0
SIMULATION_RANDOM_SEED=42

# MQTT / HiveMQ Cloud Configuration
# Set MQTT_ENABLED=True to connect to an external broker (HiveMQ Cloud or Local Mosquitto)
# Keep MQTT_ENABLED=False for offline standalone simulation
MQTT_ENABLED=False
MQTT_BROKER_HOST=your-cluster-url.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=True
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password
MQTT_TOPIC_PREFIX=factory/machines
MQTT_CLIENT_ID_PREFIX=FactoryTwin_Client

# Machine Learning Anomaly Detection Configuration
MODEL_DIR=ai_model
MODEL_PATH=ai_model/isolation_forest_model.joblib
SCALER_PATH=ai_model/scaler.joblib
ANOMALY_CONTAMINATION=0.05
ANOMALY_SCORE_THRESHOLD=65.0

# System Alert Threshold Defaults
DEFAULT_MAX_TEMP_CELSIUS=85.0
DEFAULT_MAX_VIBRATION_MMS=4.5
DEFAULT_MAX_RPM=3000.0
DEFAULT_MAX_LOAD_PCT=90.0
ALERT_COOLDOWN_SECONDS=60
